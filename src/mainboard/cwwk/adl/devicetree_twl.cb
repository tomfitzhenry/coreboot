chip soc/intel/alderlake

	register "pmc_gpe0_dw0" = "GPP_B"
	register "pmc_gpe0_dw1" = "GPP_D"
	register "pmc_gpe0_dw2" = "GPP_E"

	register "serial_io_uart_mode" = "{
		[PchSerialIoIndexUART0] = PchSerialIoSkipInit,
	}"

	register "usb2_ports[0]" = "USB2_PORT_SHORT(OC_SKIP)"
	register "usb2_ports[1]" = "USB2_PORT_SHORT(OC_SKIP)"
	register "usb2_ports[2]" = "USB2_PORT_SHORT(OC_SKIP)"
	register "usb2_ports[3]" = "USB2_PORT_SHORT(OC_SKIP)"
	register "usb2_ports[4]" = "USB2_PORT_SHORT(OC_SKIP)"
	register "usb2_ports[5]" = "USB2_PORT_SHORT(OC_SKIP)"
	register "usb2_ports[6]" = "USB2_PORT_SHORT(OC_SKIP)" # microSD card reader
	register "usb2_ports[7]" = "USB2_PORT_SHORT(OC_SKIP)"

	register "pch_pcie_rp[PCH_RP(2)]" = "{
		.clk_src = 0,
		.clk_req = 0,
		.flags = PCIE_RP_AER | PCIE_RP_CLK_REQ_DETECT | PCIE_RP_BUILT_IN,
		.pcie_rp_aspm = ASPM_L0S,
	}"

	register "pch_pcie_rp[PCH_RP(3)]" = "{
		.clk_src = 5,
		.clk_req = 5,
		.flags = PCIE_RP_AER | PCIE_RP_CLK_REQ_DETECT | PCIE_RP_BUILT_IN,
		.pcie_rp_aspm = ASPM_L0S,
	}"

	register "pch_pcie_rp[PCH_RP(4)]" = "{
		.clk_src = 6,
		.clk_req = 6,
		.flags = PCIE_RP_AER | PCIE_RP_CLK_REQ_DETECT | PCIE_RP_BUILT_IN,
		.pcie_rp_aspm = ASPM_L0S,
	}"

	register "pch_pcie_rp[PCH_RP(7)]" = "{
		.clk_src = 1,
		.clk_req = 1,
		.flags = PCIE_RP_AER | PCIE_RP_CLK_REQ_DETECT | PCIE_RP_BUILT_IN,
		.pcie_rp_aspm = ASPM_L0S,
	}"

	register "pch_pcie_rp[PCH_RP(9)]" = "{
		.clk_src = 2,
		.clk_req = 2,
		.flags = PCIE_RP_AER | PCIE_RP_CLK_REQ_DETECT | PCIE_RP_BUILT_IN,
		.pcie_rp_aspm = ASPM_L0S,
	}"

	register "pch_pcie_rp[PCH_RP(10)]" = "{
		.clk_src = 3,
		.clk_req = 3,
		.flags = PCIE_RP_AER | PCIE_RP_CLK_REQ_DETECT | PCIE_RP_BUILT_IN,
		.pcie_rp_aspm = ASPM_L0S,
	}"

	register "pch_pcie_rp[PCH_RP(11)]" = "{
		.clk_src = 4,
		.flags = PCIE_RP_AER | PCIE_RP_CLK_REQ_UNUSED | PCIE_RP_BUILT_IN,
		.pcie_rp_aspm = ASPM_L0S,
	}"

	register "ddi_ports_config" = "{
		[DDI_PORT_A] = DDI_ENABLE_HPD | DDI_ENABLE_DDC,
		[DDI_PORT_B] = DDI_ENABLE_HPD | DDI_ENABLE_DDC,
	}"

	device domain 0 on
		device ref igpu on end
		# Native SATA is unusable here: the FSP enables the controller but
		# implements no port (AHCI PI mask 0x0), most likely because the
		# enabled-but-empty RP2 (00:1c.0) owns SATA0's combo lane. Disabling
		# pcie_rp2 below is the untested fix, deliberately not pursued.
		device ref sata on
			register "sata_salp_support" = "1"
			register "sata_ports_enable[0]" = "1"
		end
		device ref crashlog off end
		device ref tcss_xhci on end
		device ref xhci on end
		device ref shared_sram on end
		device ref uart0 on end
		device ref pcie_rp2 on end
		device ref pcie_rp3 on end
		device ref pcie_rp4 on end
		device ref pcie_rp7 on end
		device ref pcie_rp9 on end
		device ref pcie_rp10 on end
		device ref pcie_rp11 on end
		device ref pch_espi on
			register "gen1_dec" = "0x00fc0201"
			register "gen2_dec" = "0x003c0a01"
			register "gen3_dec" = "0x000c0081"

			chip superio/ite/it8613e
				register "TMPIN1.mode" = "THERMAL_RESISTOR"

				# CPU_FAN
				register "FAN2.mode"            = "FAN_SMART_AUTOMATIC"
				register "FAN2.smart.tmpin"     = "1"
				register "FAN2.smart.tmp_off"   = "35"
				register "FAN2.smart.tmp_start" = "40"
				register "FAN2.smart.tmp_full"  = "88"
				register "FAN2.smart.tmp_delta" = "2"
				register "FAN2.smart.full_lmt"  = "1"
				register "FAN2.smart.smoothing" = "1"
				register "FAN2.smart.pwm_start" = "22"
				register "FAN2.smart.slope"     = "3"

				# SYS_FAN
				register "FAN3.mode"            = "FAN_SMART_AUTOMATIC"
				register "FAN3.smart.tmpin"     = "1"
				register "FAN3.smart.tmp_off"   = "32"
				register "FAN3.smart.tmp_start" = "38"
				register "FAN3.smart.tmp_full"  = "86"
				register "FAN3.smart.tmp_delta" = "2"
				register "FAN3.smart.full_lmt"  = "1"
				register "FAN3.smart.smoothing" = "1"
				register "FAN3.smart.pwm_start" = "18"
				register "FAN3.smart.slope"     = "3"
				device pnp 2e.0 off end
				device pnp 2e.1 on       # COM 1
					io 0x60 = 0x3f8
					irq 0x70 = 0x4
					irq 0xf0 = 0x1
				end
				device pnp 2e.4 on       # Environment Controller
                                        io 0x60 = 0x0a30
                                        io 0x62 = 0x0a20
                                        irq 0x70 = 0x00
                                        irq 0x71 = 0x80
				end
				device pnp 2e.5 off end  # Keyboard
				device pnp 2e.6 off end  # Mouse
				device pnp 2e.7 off end  # GPIO
				device pnp 2e.a off end  # CIR
			end
		end
		device ref hda on end
		device ref smbus on end
	end
end
