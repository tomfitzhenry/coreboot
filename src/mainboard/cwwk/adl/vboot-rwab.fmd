FLASH 16M {
	SI_ALL 0x600000 {
		SI_DESC 4K
		SI_ME
	}

	RW_MISC 0x50000 {
		UNIFIED_MRC_CACHE(PRESERVE) {
			RECOVERY_MRC_CACHE 0x20000
			RW_MRC_CACHE 0x20000
		}
		RW_NVRAM(PRESERVE) 0x6000
	}

	SMMSTORE(PRESERVE) 0x80000

	RW_SECTION_A 0x298000 {
		VBLOCK_A 0x10000
		FW_MAIN_A(CBFS)
		RW_FWID_A 0x100
	}

	RW_SECTION_B 0x298000 {
		VBLOCK_B 0x10000
		FW_MAIN_B(CBFS)
		RW_FWID_B 0x100
	}

	# Make WP_RO align with the SPI vendor memory-protected range; the
	# descriptor/ME live below it and the RW slots above it.
	WP_RO 0x400000 {
		RO_SECTION {
			FMAP 0x800
			RO_FRID 0x100
			RO_FRID_PAD 0x700
			GBB 0x3000
			COREBOOT(CBFS)
		}
	}
}
